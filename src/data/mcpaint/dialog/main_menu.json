{
  "type": "minecraft:multi_action",
  "title": "MC Paint",
  "after_action": "none",
  "pause": false,
  "body": [
    {
      "type": "minecraft:item",
      "item": {
        "id": "minecraft:painting"
      },
      "description": {
        "text": "",
        "extra": [
          {
            "text":"MC Paint",
            "color": "gold"
          },
          {
            "text": " is a Datapack that adds "
          },
          {
            "text": "in-game paintable custom paintings",
            "color": "gold"
          },
          {
            "text": " to Minecraft! To get started, craft a "
          },
          {
            "text": "Studio",
            "color": "gold"
          },
          {
            "text": " by throwing an "
          },
          {
            "text": "Egg",
            "color": "gold"
          },
          {
            "text": " at a Vanilla "
          },
          {
            "text": "Painting",
            "color": "gold"
          },
          {
            "text": ". For a full breakdown of all the features, check out the wiki linked below!"
          }
        ]
      }
    }
  ],
  "columns": 2,
  "actions": [
    {
      "label": "Download Page",
      "action": {
        "type": "minecraft:open_url",
        "url": "https://modrinth.com/datapack/mc-paint"
      }
    },
    {
      "label": {
        "text": "Support me on Ko-fi ",
        "extra": [
          {
            "text": "❤",
            "color": "red"
          }
        ]
      },
      "action": {
        "type": "minecraft:open_url",
        "url": "https://ko-fi.com/eroxen"
      }
    },
    {
      "label": "Wiki",
      "action": {
        "type": "minecraft:open_url",
        "url": "https://github.com/Eroxen/MC-Paint-datapack/wiki"
      }
    },
    {
      "label": "Report an Issue",
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "mcpaint:report_an_issue"
      }
    },
    {
      "label": "Credits",
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "mcpaint:credits"
      }
    },
    {
      "label": "Client Config",
      "action": {
        "type": "minecraft:run_command",
        "command": "/trigger mcpaint.settings"
      }
    },
    {
      "label": "Server Config",
      "action": {
        "type": "minecraft:run_command",
        "command": "/function mcpaint:settings/api/trigger_server"
      }
    }
  ]
}