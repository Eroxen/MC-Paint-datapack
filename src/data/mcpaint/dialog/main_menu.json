  "columns": 2,
  "actions": [
    {
      "label": "Download Page",
      "action": {
        "type": "minecraft:open_url",
        "url": "https://modrinth.com/datapack/catenary"
      }
    },
    {
      "label": {
        "text": "Support me on Ko-fi ",
        "extra": [
          {
            "text": "❤",
            "color": "red"
          }
        ]
      },
      "action": {
        "type": "minecraft:open_url",
        "url": "https://ko-fi.com/eroxen"
      }
    },
    {
      "label": "Wiki",
      "action": {
        "type": "minecraft:open_url",
        "url": "https://github.com/Eroxen/Catenary-datapack/wiki"
      }
    },
    {
      "label": {
        "translate": "gui.stats"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/trigger catenary.dialog set 101"
      }
    },
    {
      "label": "Report an Issue",
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "catenary:report_an_issue"
      }
    },
    {
      "label": "Credits",
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "catenary:credits"
      }
    },
    {
      "label": "Config",
      "action": {
        "type": "minecraft:run_command",
        "command": "/function catenary:config/show_dialog"
      }
    }
  ]
