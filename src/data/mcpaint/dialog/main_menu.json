{
  "type": "minecraft:multi_action",
  "title": "MC Paint",
  "after_action": "none",
  "pause": false,
  "body": [
    {
      "type": "minecraft:plain_message",
      "width": 300,
      "contents": {
        "text":"howdy"
      }
    }
